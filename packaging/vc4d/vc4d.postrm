#!/bin/sh
# vc4d postrm: on purge, leave no unit, no socket and no empty group behind.
set -e

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload || true
fi

if [ "$1" = purge ]; then
	rm -f /run/vc4d.sock /run/vc4d.pid
	rmdir /run/vc4d 2>/dev/null || true
	rm -f /etc/default/vc4d.dpkg-* 2>/dev/null || true
	# drop-in directories belong to vc4-toolkit-fast; only prune if empty
	rmdir /etc/systemd/system/vc4d.service.d 2>/dev/null || true
	# the group may still be a member's primary/secondary group: only-if-empty
	if command -v delgroup >/dev/null 2>&1; then
		delgroup --system --only-if-empty vc4 >/dev/null 2>&1 || true
	else
		groupdel vc4 >/dev/null 2>&1 || true
	fi
fi

exit 0
