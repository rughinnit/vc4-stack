#!/bin/sh
# vc4d postinst: create the vc4 group, drop the unpackaged unit that would
# shadow ours, reload systemd and (re)start the daemon.
set -e

if ! getent group vc4 >/dev/null 2>&1; then
	addgroup --system vc4 >/dev/null
fi

# The daemon used to be installed by hand as
#   /usr/local/sbin/vc4d  +  /etc/systemd/system/vc4d.service
# An /etc unit wins over /lib/systemd/system, so remove it when no package
# owns it; the binary itself is left alone (it is harmless, and may be a
# developer's own build), but the unit must be ours.
if [ -f /etc/systemd/system/vc4d.service ] &&
   ! dpkg-query -S /etc/systemd/system/vc4d.service >/dev/null 2>&1; then
	rm -f /etc/systemd/system/vc4d.service
fi

# Add the invoking user to vc4 so unprivileged use works without a second
# command.  Never touch root, and never fail the install if usermod dislikes
# the name.
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ] &&
   getent passwd "$SUDO_USER" >/dev/null 2>&1; then
	usermod -aG vc4 "$SUDO_USER" || true
fi

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload || true
	systemctl enable vc4d.service >/dev/null 2>&1 || true
	# `restart` also covers the upgrade case (old binary, same unit name)
	systemctl restart vc4d.service ||
		systemctl start vc4d.service || true
fi

cat <<'EOF'
vc4d: the client socket is /run/vc4d.sock (mode 0660, group vc4).
      Add users with:  sudo usermod -aG vc4 <user>
      Check it with:   vc4-query
EOF

exit 0
